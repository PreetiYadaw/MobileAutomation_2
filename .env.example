# Copy this file to .env and fill in your real values. Never commit .env.

# ============================================================
# LLM PROVIDER SELECTION - two INDEPENDENT toggles
# ============================================================
# LLM_PROVIDER handles TEXT/PLANNING calls (deciding the next action).
# Choose whichever you want: groq | azure | deepseek
LLM_PROVIDER=groq

# VISION_LLM_PROVIDER handles screenshot-understanding calls (locator
# fallback + ambiguous verification). DeepSeek's models take text only -
# they cannot see images - so this must be: groq | azure
VISION_LLM_PROVIDER=groq

# You only need to fill in the credentials below for whichever provider(s)
# you actually selected above. Leave the others blank.

# ---- Groq (needed if LLM_PROVIDER=groq and/or VISION_LLM_PROVIDER=groq) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Confirmed working vision model on Groq:
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ---- Azure OpenAI (needed if LLM_PROVIDER=azure and/or VISION_LLM_PROVIDER=azure) ----
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# This must be your DEPLOYMENT NAME from Azure AI/OpenAI Studio, not the
# underlying model name (e.g. deployment "my-gpt41" not model "gpt-4.1").
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Optional: only set this if your vision-capable deployment has a DIFFERENT
# name than AZURE_OPENAI_DEPLOYMENT above. gpt-4.1 is natively multimodal,
# so most setups can leave this blank and reuse the same deployment.
AZURE_OPENAI_VISION_DEPLOYMENT=

# ---- DeepSeek (needed if LLM_PROVIDER=deepseek - text/planning only, no vision) ----
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Target ----
# web | android | ios
PLATFORM=web
TARGET_URL=https://www.saucedemo.com

# ---- Appium (only needed once you move to PLATFORM=android) ----
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=Android Device
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# ---- Agent behaviour ----
MAX_STEPS=15
FUZZY_MATCH_THRESHOLD=75
# Turn OFF to force pure DOM/text-only operation (faster, cheaper, but the
# agent will fail on elements/checks it truly cannot determine from text).
ENABLE_VISION_FALLBACK=true
# Auto-accepts Android runtime permission dialogs (camera/location/notif)
# at session start so the agent doesn't have to deal with them mid-run.
ANDROID_AUTO_GRANT_PERMISSIONS=true
# Auto-dismiss cookie banners / consent popups / "allow" dialogs before every step.
POPUP_DISMISS_ENABLED=true
# Pixels to scroll per web "scroll" action (mobile uses a proportional swipe instead).
SCROLL_PIXELS=600
